APP_ENV=production
APP_NAME=Customer Service Platform
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=csp
POSTGRES_USER=csp
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://csp:replace-with-a-long-random-password@postgres:5432/csp
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

BOOTSTRAP_ENABLED=false
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_IP_ATTEMPTS=20
AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
SECURE_HEADERS_HSTS_ENABLED=true
FORWARDED_ALLOW_IPS=127.0.0.1
CORS_ALLOW_ORIGINS=https://support.example.com
METRICS_BEARER_TOKEN=replace-with-a-long-random-token
LOG_LEVEL=INFO

LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_WORKSPACE_REQUESTS_PER_MINUTE=12
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30

# Bind web only to loopback when a reverse proxy/tunnel runs on this host.
CSP_WEB_BIND=127.0.0.1:8180
CSP_BUILD_REVISION=unknown
