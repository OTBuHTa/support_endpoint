APP_ENV=development
APP_NAME=Customer Service Platform
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://csp:csp@postgres:5432/csp
REDIS_URL=redis://redis:6379/0

# Required: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=replace-with-at-least-32-random-bytes-before-external-access
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# One-time, install-wide initial owner/workspace creation.
# Set to false after the first POST /api/v1/auth/bootstrap call.
BOOTSTRAP_ENABLED=true

# Production security
# Required and non-empty when APP_ENV=production.
METRICS_BEARER_TOKEN=

# HSTS must only be enabled when HTTPS termination is correctly configured.
SECURE_HEADERS_HSTS_ENABLED=false

# Redis-backed login abuse protection.
AUTH_RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_IP_ATTEMPTS=20
AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=10

# Reverse proxy trust boundary.
# Set to the exact reverse-proxy IP/CIDR in production. Never "*" on
# an Internet-reachable deployment.
FORWARDED_ALLOW_IPS=127.0.0.1

# CORS — comma-separated list of allowed origins for the web frontend.
CORS_ALLOW_ORIGINS=http://localhost:8180

LOG_LEVEL=INFO

# --- AI / LLM (inert until Phase 6 wires it up) ---
# This project runs on the same host as the shared Ollama instance
# (srv-ai) and reaches it via the Docker host-gateway alias, exactly
# like AI-project-SRV does — never hardcode the LAN/WAN address here.
LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
