# Host-level operations configuration. Do not commit the real file.
# Install as /etc/support-endpoint/backup-offhost.env with mode 600.

# SSH destination with pre-provisioned key and known_hosts entry for support-runner.
CSP_BACKUP_SSH_REMOTE=backup-user@backup-host.example

# Absolute destination directory on the remote host.
CSP_BACKUP_REMOTE_DIR=/srv/backups/support-endpoint
